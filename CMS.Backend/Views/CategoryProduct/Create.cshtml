@model CMS.Data.Entities.CategoryProduct
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm danh mục sản phẩm";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">➕ THÊM DANH MỤC SẢN PHẨM MỚI</h4>
        </div>
        <div class="card-body">
            <form asp-controller="CategoryProduct" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Tên danh mục</label>
                    <input asp-for="Name" class="form-control" placeholder="Ví dụ: Áo sơ mi nam, Giày thể thao..." required />
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả chi tiết</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả cho nhóm sản phẩm này..."></textarea>
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-controller="CategoryProduct" asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    <button type="submit" class="btn btn-success">Lưu dữ liệu</button>
                </div>
            </form>
        </div>
    </div>
</div>