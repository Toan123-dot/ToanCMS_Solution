@model IEnumerable<CMS.Data.Entities.Post>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Home Page";
}
<div class="container mt-5">
    <h2 class="text-center mb-4 text-danger">TIN TỨC MỚI NHẤT</h2>
    <div class="row">
        @foreach (var item in Model ?? Enumerable.Empty<CMS.Data.Entities.Post>())
        {
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" />
                    <div class="card-body">
                        <span class="badge bg-primary mb-2">@item.Category?.Name</span>
                        <h5 class="card-title">@item.Title</h5>
                        @{
                            var plainText = System.Text.RegularExpressions.Regex.Replace(item.Content ?? "", "<.*?>", string.Empty);
                        }
                        <p>@plainText</p>
                        <a href="/Post/Details/@item.Id" class="btn btn-outline-danger btn-sm">Đọc tiếp</a>
                    </div>
                    <div class="card-footer text-muted small">
                        Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>
        }
    </div>

    
</div>
</div>