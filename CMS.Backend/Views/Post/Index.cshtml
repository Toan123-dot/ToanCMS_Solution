@model IEnumerable<CMS.Data.Entities.Post>

@{
    Layout = "_LayoutAdmin"; 
    ViewData["Title"] = "Quản lý bài viết";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0 text-danger">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>
        <a asp-action="Create" class="btn btn-success">
            
            <i class="bi bi-plus-circle"></i> Thêm bài viết mới 
        </a>
    </div>

    <h2 class="mb-4 text-danger">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>
    <a asp-action="Create" class="btn btn-success mb-3">
        <i class="bi bi-plus-circle"></i> Thêm bài viết mới
    </a>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm">
                
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/uploads/default.jpg" : item.ImageUrl)" class="card-img-top" alt="Thumbnail"> 
                        <div class="card-body">
                            
                            <span class="badge bg-info text-dark">@item.Category.Name</span> 

                            <h5 class="card-title text-primary">@item.Title</h5> 

                            <p class="card-text text-truncate">@Html.Raw(item.Content)</p>

                            <p class="text-muted small">Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</p> 
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a> 

                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                
                                Sửa 
                            </a>
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge bg-info text-dark mb-2">@item.Category?.Name</span>
                            <h5 class="card-title text-primary">@item.Title</h5>

                            <p class="card-text text-truncate">
                                @System.Text.RegularExpressions.Regex.Replace(item.Content ?? "", "<.*?>", string.Empty)
                            </p>
                        </div>

                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Chúng ta có chắc chắn muốn xóa bài viết này không?')">
                                
                                <i class="bi bi-trash"></i> Xóa 
                            </a>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">Không có bài viết nào để hiển thị.</div>
            </div>
        }
    </div>
</div>
                        <div class="mt-3">
                            <p class="text-muted small mb-2">Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</p>
                            <div class="d-flex gap-1">
                                <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm">Xem</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Chúng ta có chắc chắn muốn xóa bài viết này không?')">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>