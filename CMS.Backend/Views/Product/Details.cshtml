@model CMS.Data.Entities.Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "_LayoutAdmin";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">🔍 CHI TIẾT SẢN PHẨM</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-5 text-center mb-3">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@(Model.ImageUrl.StartsWith("http") ? Model.ImageUrl : Url.Content("~/images/" + Model.ImageUrl))"
                             class="img-fluid rounded shadow-sm" alt="@Model.Name" style="max-height: 250px; object-fit: cover;">
                    }
                    else
                    {
                        <img src="~/images/no-image.png" class="img-fluid rounded shadow-sm" alt="No image" style="max-height: 250px;">
                    }
                </div>

                <div class="col-md-7">
                    <h3 class="text-primary fw-bold">@Model.Name</h3>
                    <hr />

                    <p><strong>Mô tả:</strong> @Model.Description</p>
                    <p class="fs-5 text-danger"><strong>Giá bán:</strong> @Model.Price.ToString("#,##0") VNĐ</p>
                    <p><strong>Số lượng còn lại:</strong> <span class="badge bg-success">@Model.StockQuantity sản phẩm</span></p>
                    <p><strong>Mã danh mục liên kết:</strong> <span class="badge bg-secondary">@Model.CategoryProductId</span></p>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4 border-top pt-3">
                <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Chuyển sang trang Sửa</a>
            </div>
        </div>
    </div>
</div>