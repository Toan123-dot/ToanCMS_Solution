@model CMS.Data.Entities.Product
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "_LayoutAdmin";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">➕ THÊM SẢN PHẨM MỚI</h4>
        </div>
        <div class="card-body">
            <form asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" required placeholder="Nhập tên sản phẩm..." />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả sản phẩm</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập mô tả ngắn..."></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ)</label>
                        <input asp-for="Price" type="number" class="form-control" required value="0" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="StockQuantity" class="form-label fw-bold">Số lượng kho</label>
                        <input asp-for="StockQuantity" type="number" class="form-control" required value="1" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Hình ảnh sản phẩm</label>
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" required />
                    <small class="text-muted">Chọn file ảnh (.jpg, .jpeg, .png, .webp)</small>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryProductId" class="form-label fw-bold">Mã danh mục (ID)</label>
                    <input asp-for="CategoryProductId" type="number" class="form-control" required />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    <button type="submit" class="btn btn-primary">Lưu sản phẩm</button>
                </div>
            </form>
        </div>
    </div>
</div>