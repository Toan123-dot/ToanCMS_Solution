@model CMS.Data.Entities.Product
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
    Layout = "_LayoutAdmin";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0 fw-bold">✏️ CHỈNH SỬA SẢN PHẨM</h4>
        </div>
        <div class="card-body">
            <form asp-controller="Product" asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả sản phẩm</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ)</label>
                        <input asp-for="Price" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="StockQuantity" class="form-label fw-bold">Số lượng kho</label>
                        <input asp-for="StockQuantity" type="number" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Hình ảnh sản phẩm (Để trống nếu giữ nguyên ảnh cũ)</label>
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" />

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mt-2">
                            <span class="small text-muted d-block mb-1">Ảnh hiện tại:</span>
                            <img src="@(Model.ImageUrl.StartsWith("http") ? Model.ImageUrl : Url.Content("~/images/" + Model.ImageUrl))"
                                 alt="Current Image" class="img-thumbnail" style="max-height: 100px;">
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryProductId" class="form-label fw-bold">Mã danh mục (ID)</label>
                    <input asp-for="CategoryProductId" type="number" class="form-control" required />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    <button type="submit" class="btn btn-warning fw-bold">Cập nhật dữ liệu</button>
                </div>
            </form>
        </div>
    </div>
</div>