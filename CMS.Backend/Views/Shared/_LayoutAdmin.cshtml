<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ToanCMS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .sidebar {
            min-height: 100vh;
            background-color: #212529;
            color: white;
        }

            .sidebar a {
                color: #adb5bd;
                text-decoration: none;
                display: block;
                padding: 10px 20px;
            }

                .sidebar a:hover {
                    background-color: #343a40;
                    color: white;
                }

            .sidebar .active {
                background-color: #0d6efd !important;
                color: white !important;
            }

            .sidebar .navbar-nav {
                padding: 15px;
                text-align: center;
                border-bottom: 1px solid #343a40;
            }

                .sidebar .navbar-nav .text-dark {
                    color: #adb5bd !important;
                    font-size: 14px;
                    display: block;
                    margin-bottom: 5px;
                }

                    .sidebar .navbar-nav .text-dark strong {
                        color: #ffffff !important;
                    }

                .sidebar .navbar-nav form button {
                    width: 85%;
                    margin: 5px auto 0 auto;
                }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 sidebar p-0">
                <div class="p-3 text-center border-bottom border-secondary">
                    <h4 class="text-white">ToanCMS Admin</h4>
                </div>
                <ul class="navbar-nav ms-auto">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-dark">
                                Chào, <strong>@(User?.FindFirst("FullName")?.Value ?? "User")</strong> (@(User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "NoRole"))
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm-custom btn-outline-danger btn-sm">
                                    Đăng xuất
                                </button>
                            </form>
                        </li>
                    }
                </ul>
                <div class="mt-3 list-menu-sidebar">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Bảng điều khiển</a>
                    <a asp-controller="Category" asp-action="Index"><i class="bi bi-grid"></i> Quản lý Danh mục</a>
                    <a asp-controller="Post" asp-action="Index"><i class="bi bi-file-earmark-post"></i> Quản lý Bài viết</a>
                    <a asp-controller="User" asp-action="Index"><i class="bi bi-people"></i> Quản lý Thành viên</a>
                    <a asp-controller="ProductCategory" asp-action="Index"><i class="bi bi-grid"></i> Danh mục sản phẩm</a>
                    <a asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam"></i> Sản phẩm</a>
                    <a asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Khách hàng</a>
                    <a asp-controller="Orders" asp-action="Index"><i class="bi bi-grid"></i> Đơn hàng</a>
                    <a asp-controller="OrderDetail" asp-action="Index"><i class="bi bi-grid"></i> Đơn hàng chi tiết</a>
                </div>
            </nav>

            <main class="col-md-9 col-lg-10 ms-sm-auto p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            var currentUrl = window.location.pathname.toLowerCase().replace(/\/index$/, '');
            if (currentUrl.endsWith('/')) {
                currentUrl = currentUrl.slice(0, -1);
            }

            $(".sidebar a").each(function () {
                var menuUrl = $(this).attr("href") ? $(this).attr("href").toLowerCase().replace(/\/index$/, '') : "";
                if (menuUrl.endsWith('/')) {
                    menuUrl = menuUrl.slice(0, -1);
                }

                if (currentUrl === menuUrl || (menuUrl !== "/" && menuUrl !== "" && currentUrl.startsWith(menuUrl + "/"))) {
                    $(this).addClass("active");
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
